# Скопіюй цей файл як .env і зміни значення.
# .env НЕ заливається на github (він в .gitignore)

# локально True, на сервері обов'язково False
DJANGO_DEBUG=True

# згенерувати новий ключ:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# домени через кому
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://mysite.com

# вмикати тільки коли сайт працює по https
DJANGO_USE_HTTPS=False

# якщо є Redis - розкоментуй (без нього кеш буде в пам'яті)
# REDIS_URL=redis://127.0.0.1:6379/1

# скільки запитів на хвилину можна з одного IP
RATELIMIT_GLOBAL_PER_MINUTE=300

# ключ RAWG для python manage.py fetch_covers (справжні обкладинки ігор)
# отримати безкоштовно: https://rawg.io/apidocs
# RAWG_API_KEY=
